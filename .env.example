# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Contact form email delivery (https://resend.com)
# Sign up to Resend with willandash@outlook.com, create an API key, paste it here.
# That is all that is needed: enquiries are then emailed to willandash@outlook.com.
RESEND_API_KEY=

# Optional. Where enquiries are sent (defaults to the firm's email in src/content/site.ts).
# Comma-separate multiple addresses. Other addresses only work once a domain is verified in Resend.
CONTACT_TO_EMAIL=

# Optional. Sender address. Leave empty to use Resend's shared sender (onboarding@resend.dev).
# After verifying the firm's domain in Resend, set e.g. "Will & Ash Website <website@willandash.com>".
CONTACT_FROM_EMAIL=
